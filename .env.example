# Copy this file to `.env` and set the path to your downloaded data package.
# The laser_polio_nigeria package loads `.env` automatically on import, so this
# works in a plain terminal, VSCode, and pytest — no per-terminal `export`.
# A real environment variable always wins over `.env`, so on AKS/in containers
# set LASER_POLIO_DATA in the pod/job spec instead of shipping a .env.
#
# Use an ABSOLUTE path — ~ is not expanded.
# Point at the directory containing manifest.py:
#   - public Zamfara data:  /Users/<you>/zamfara_data
#   - private Nigeria data: /Users/<you>/nigeria_polio_data
LASER_POLIO_DATA=/absolute/path/to/zamfara_data
